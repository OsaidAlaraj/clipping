# Copy to .env and fill in. Never commit .env. See docs/open-items.md.
CLIPPING_USE_FAKES=1
AUTH_MODE=passkey
CLIPPING_LOCAL_TOKEN=
CLIPPING_PUBLIC_ORIGIN=
CLIPPING_API_HOST=127.0.0.1
CLIPPING_API_PORT=8787
CLIPPING_DATA_DIR=
CLIPPING_MEDIA_SECRET=
FFMPEG_PATH=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
DEEPGRAM_API_KEY=
VIZARD_API_KEY=
KLAP_API_KEY=
OPUSCLIP_API_KEY=
BUFFER_ACCESS_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Posting (phase E). TOKEN_VAULT_KEY = base64 of 32 random bytes; it seals the OAuth tokens stored in the database.
TOKEN_VAULT_KEY=
OAUTH_REDIRECT_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram test mode: 1 = do everything except the final publish call
CLIPPING_PUBLISH_DRY_RUN=0
